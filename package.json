    "express": "^4.22.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.1",
    "viem": "^2.23.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
